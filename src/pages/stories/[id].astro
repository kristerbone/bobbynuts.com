---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Bobby from '../../components/Bobby.astro';

export async function getStaticPaths() {
  const stories = (await getCollection('stories')).sort((a, b) => a.data.order - b.data.order);
  return stories.map((story, i) => ({
    params: { id: story.id },
    props: { story, prev: stories[i - 1], next: stories[i + 1] },
  }));
}
const { story, prev, next } = Astro.props;
const { Content } = await render(story);
---
<Base title={story.data.title} description={story.data.summary}>
  <article class="story">
    <p class="meta">Story {story.data.order} · {story.data.readingMinutes} minute read</p>
    <h1>{story.data.emoji} {story.data.title}</h1>
    <div class="toolbar" role="group" aria-label="Reading helpers">
      <button class="btn alt" id="listen" type="button" aria-pressed="false">🔊 Listen</button>
      <button class="btn alt" id="bigger" type="button">A+ Bigger text</button>
      <button class="btn alt" id="smaller" type="button">A- Smaller text</button>
    </div>
    <div class="illus"><Bobby size={160} /></div>
    <div class="story-body" id="story-text"><Content /></div>
    <p><strong>The End</strong> 🌰</p>
  </article>
  <nav class="pager" aria-label="More stories">
    {prev ? <a class="btn" href={`/stories/${prev.id}/`}>← {prev.data.title}</a> : <span />}
    {next ? <a class="btn" href={`/stories/${next.id}/`}>{next.data.title} →</a> : <a class="btn" href="/stories/">All stories</a>}
  </nav>

  <script>
    const text = document.getElementById('story-text');
    const listen = document.getElementById('listen');
    const root = document.documentElement;
    let size = 1.3;
    const setSize = (n) => { size = Math.min(2.2, Math.max(1, n)); root.style.setProperty('--story-size', size + 'rem'); };
    document.getElementById('bigger')?.addEventListener('click', () => setSize(size + 0.15));
    document.getElementById('smaller')?.addEventListener('click', () => setSize(size - 0.15));

    if (!('speechSynthesis' in window)) {
      listen?.setAttribute('hidden', '');
    } else {
      let speaking = false;
      const stop = () => { speechSynthesis.cancel(); speaking = false; listen.textContent = '🔊 Listen'; listen.setAttribute('aria-pressed', 'false'); };
      listen?.addEventListener('click', () => {
        if (speaking) return stop();
        const u = new SpeechSynthesisUtterance(text.innerText);
        u.lang = 'en-GB';
        u.rate = 0.9;
        u.onend = stop;
        speechSynthesis.speak(u);
        speaking = true;
        listen.textContent = '⏹ Stop';
        listen.setAttribute('aria-pressed', 'true');
      });
      window.addEventListener('pagehide', () => speechSynthesis.cancel());
    }
  </script>
</Base>
