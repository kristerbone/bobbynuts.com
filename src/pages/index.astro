---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Bobby from '../components/Bobby.astro';
const stories = (await getCollection('stories')).sort((a, b) => a.data.order - b.data.order);
---
<Base>
  <section class="hero">
    <div>
      <h1>Hello, I'm Bobby Nuts!</h1>
      <p>I'm a wee red squirrel who lives at the very top of Good Wood. I'm off on a big journey down the Burn to make new friends. Come and share my adventures!</p>
      <p><a class="btn" href="/stories/">Read the stories</a> <a class="btn alt" href="/about/">Meet Bobby Nuts</a></p>
    </div>
    <div class="illus"><Bobby size={240} /></div>
  </section>

  <h2>Latest adventures</h2>
  {stories.length === 0 && <p>Bobby Nuts's first adventure is coming soon.</p>}
  <ul class="cards">
    {stories.map((s) => (
      <li class="card">
        <a href={`/stories/${s.id}/`}>
          <div class="emoji" aria-hidden="true">{s.data.emoji}</div>
          <h3>{s.data.title}</h3>
          <p>{s.data.summary}</p>
          <span class="meta">{s.data.readingMinutes} minute read</span>
        </a>
      </li>
    ))}
  </ul>
</Base>
